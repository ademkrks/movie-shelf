{
  "name": "movie-shelf",
  "version": "1.0.0",
  "description": "REST API for Movie Shelf application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:integration": "node scripts/runIntegrationTests.js",
    "test:all": "npm test && npm run test:integration",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "movies"
  ],
  "author": "Ali",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}