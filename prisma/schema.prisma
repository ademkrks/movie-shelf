// Prisma Client oluşturur
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL veri kaynağı
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Film tablosu
model Movie {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Kullanıcı rolleri
enum Role {
  USER
  ADMIN
}

// Kullanıcı tablosu
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(USER)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  favorites           Favorite[]
  watchlists          Watchlist[]
  reviews             Review[]
  ratings             Rating[]
  passwordResetTokens PasswordResetToken[]
}

// Favoriler tablosu
model Favorite {
  id          Int      @id @default(autoincrement())
  userId      Int
  tmdbMovieId Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbMovieId])
  @@index([userId, createdAt(sort: Desc)])
}

// İzleme listesi tablosu
model Watchlist {
  id          Int      @id @default(autoincrement())
  userId      Int
  tmdbMovieId Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbMovieId])
  @@index([userId, createdAt(sort: Desc)])
}

// Film yorumları tablosu
model Review {
  id          Int      @id @default(autoincrement())
  content     String
  userId      Int
  tmdbMovieId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbMovieId, createdAt(sort: Desc)])
  @@index([userId])
}

// Film puanları tablosu
model Rating {
  id          Int      @id @default(autoincrement())
  rating      Int
  userId      Int
  tmdbMovieId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbMovieId])
  @@index([tmdbMovieId, createdAt(sort: Desc)])
}

// Şifre sıfırlama tokenları
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
