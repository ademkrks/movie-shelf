// Prisma Client oluşturur
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL veri kaynağı
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Film tablosu
model Movie {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}