// Prisma Client oluşturur
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// PostgreSQL veri kaynağı
datasource db {
  provider = "postgresql"
}

// Film tablosu
model Movie {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}